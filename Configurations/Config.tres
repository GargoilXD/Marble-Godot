[gd_resource type="Resource" script_class="ConfigurationData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Configurations/ConfigurationData.gd" id="1_1mhnw"]

[resource]
script = ExtResource("1_1mhnw")
Code = "Function Integer Multiply(Integer A, Integer B){
	Integer Result = 0
	if (A < B){
		For Integer i in Range(A){
			
			Result = Add(Result, B)
		}
	}
	else{
		For Integer i in Range(B){
			Result = Add(Result, A)
		}
	}
	Return Result
}

Function Integer Add(Integer A, Integer B){
	Return A + B
}

Print(Multiply(10, 20))"
StopAt = 2
