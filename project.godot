; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Marble"
run/main_scene="res://Source code/InstructionProcessor.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://Assets/Icons/Marble.png"

[display]

window/size/mode=2

[dotnet]

project/assembly_name="InstructionProcessor"

[file_customization]

folder_colors={
"res://Assets/": "orange",
"res://Configurations/": "yellow",
"res://Modules/": "red",
"res://Source code/": "red",
"res://Tests/": "pink"
}

[filesystem]

import/blender/enabled=false

[input]

Save={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":true,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":83,"key_label":0,"unicode":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
